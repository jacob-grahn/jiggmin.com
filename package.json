{
  "name": "jiggmin-midnight-den",
  "private": true,
  "type": "module",
  "scripts": {
    "cloud:status": "python3 scripts/runpod_bake.py status",
    "cloud:quote": "python3 scripts/runpod_bake.py quote",
    "cloud:bake": "python3 scripts/runpod_bake.py benchmark",
    "cloud:test": "python3 -m unittest discover -s tests -p 'test_runpod_bake.py'",
    "start": "npm run build && python3 scripts/serve.py",
    "start:source": "python3 scripts/serve.py --source",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "python3 scripts/build_routes.py",
    "perf:visibility": "node scripts/benchmark-visibility.mjs",
    "assets:compare": "node scripts/compress-assets.mjs",
    "preview:house": "python3 scripts/house_preview.py serve",
    "preview:house:build": "python3 scripts/house_preview.py build",
    "preview:house:export": "python3 scripts/house_preview.py export",
    "preview:house:render": "python3 scripts/house_preview.py render",
    "preview:house:check": "node scripts/check-house-preview.mjs",
    "preview:house:finish": "python3 scripts/house_preview.py finish",
    "preview:house:sample": "node scripts/sample-house-preview.mjs",
    "release:house:classify": "node scripts/classify-house-release.mjs",
    "release:house:publish": "python3 scripts/house_release.py publish",
    "release:house:check": "node --test tests/house-release.test.mjs && node scripts/check-house-release.mjs",
    "release:house:prepare": "python3 scripts/house_release.py prepare",
    "release:house:test": "python3 scripts/house_release.py test --review",
    "release:house:bake": "python3 scripts/house_release.py release",
    "release:house:style": "node scripts/restore-house-style.mjs"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.6.0",
    "cannon-es": "0.20.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "sharp": "^0.35.5"
  }
}
